{
  "name": "euniversite-live",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c orange,gray \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run migrate -w server",
    "db:seed": "npm run seed -w server",
    "test": "npm run test -w server",
    "load": "npm run load -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
