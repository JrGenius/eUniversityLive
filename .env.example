# Base PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://euniv:euniv@localhost:5442/euniv_live
PORT=3100
# Secret de signature des jetons professeur : générez-en un long et aléatoire (openssl rand -hex 32)
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
# URL publique vue par les téléphones (utilisée dans le QR code). Ex: http://192.168.1.20:3100
PUBLIC_URL=http://localhost:5173
# Compte professeur créé par `npm run db:seed`
TEACHER_EMAIL=prof@euniversite.local
TEACHER_PASSWORD=ChangeMoi!2024
TEACHER_NAME=Professeur Démo
# Origines autorisées (CORS / Socket.IO), séparées par des virgules. Vide = même origine uniquement.
CORS_ORIGINS=http://localhost:5173
# 1 si le serveur est derrière un proxy inverse (IP client lue via X-Forwarded-For)
TRUST_PROXY=0
